{
  "openapi": "3.1.0",
  "info": {
    "title": "Get Idiomas AI Evaluation Service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root health endpoint",
        "operationId": "root_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Check operational health and Zero Data Retention policy status.",
        "operationId": "get_health_internal_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/evaluate": {
      "post": {
        "tags": [
          "Evaluation"
        ],
        "summary": "Evaluate writing submission",
        "description": "Executes the LangGraph evaluation pipeline over the candidate text.",
        "operationId": "evaluate_submission_internal_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIDetectionResult": {
        "properties": {
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability",
            "description": "Estimated probability of synthetic AI generation"
          },
          "is_likely_ai": {
            "type": "boolean",
            "title": "Is Likely Ai",
            "description": "Alert flag indicating probable AI generation"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "title": "Confidence",
            "description": "Confidence band of the detection assessment"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale",
            "description": "Detailed justification of stylistic and syntactic indicators"
          }
        },
        "type": "object",
        "required": [
          "probability",
          "is_likely_ai",
          "confidence",
          "rationale"
        ],
        "title": "AIDetectionResult"
      },
      "CriterionEvaluation": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Assessment criterion (Content, Communicative Achievement, Organisation, Language)"
          },
          "score": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Assigned band score from 0.0 to 5.0"
          },
          "max_score": {
            "type": "number",
            "minimum": 1.0,
            "title": "Max Score",
            "description": "Maximum attainable band score",
            "default": 5.0
          },
          "band_descriptor": {
            "type": "string",
            "title": "Band Descriptor",
            "description": "Official descriptor matching the assigned band"
          },
          "justification": {
            "type": "string",
            "title": "Justification",
            "description": "Detailed pedagogical justification citing textual evidence"
          }
        },
        "type": "object",
        "required": [
          "name",
          "score",
          "band_descriptor",
          "justification"
        ],
        "title": "CriterionEvaluation"
      },
      "EvaluationRequest": {
        "properties": {
          "submission_id": {
            "type": "string",
            "title": "Submission Id",
            "description": "UUID or unique identifier of the student submission"
          },
          "student_text": {
            "type": "string",
            "minLength": 1,
            "title": "Student Text",
            "description": "Student written submission text"
          },
          "task_prompt": {
            "type": "string",
            "minLength": 1,
            "title": "Task Prompt",
            "description": "Assignment writing prompt and instructions"
          },
          "level": {
            "type": "string",
            "enum": [
              "B1",
              "B2",
              "C1",
              "C2"
            ],
            "title": "Level",
            "description": "Target Cambridge / CEFR examination level"
          },
          "text_type": {
            "type": "string",
            "enum": [
              "essay",
              "article",
              "report",
              "review",
              "email",
              "proposal",
              "story"
            ],
            "title": "Text Type",
            "description": "Target text genre"
          },
          "min_words": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Words",
            "description": "Minimum expected word count"
          },
          "max_words": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Words",
            "description": "Maximum expected word count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "submission_id",
          "student_text",
          "task_prompt",
          "level",
          "text_type"
        ],
        "title": "EvaluationRequest"
      },
      "EvaluationResponse": {
        "properties": {
          "submission_id": {
            "type": "string",
            "title": "Submission Id",
            "description": "Submission identifier"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Word Count",
            "description": "Total words counted in the student submission"
          },
          "mistakes": {
            "items": {
              "$ref": "#/components/schemas/MistakeAnnotation"
            },
            "type": "array",
            "title": "Mistakes",
            "description": "List of identified errors with character offsets"
          },
          "exemplar_model": {
            "type": "string",
            "title": "Exemplar Model",
            "description": "Band 5 exemplary rewritten version of the text"
          },
          "rubric_evaluation": {
            "$ref": "#/components/schemas/RubricEvaluation",
            "description": "Detailed Cambridge rubric bands evaluation and institutional grade"
          },
          "feedback": {
            "$ref": "#/components/schemas/PedagogicalFeedback",
            "description": "Pedagogical feedback including strengths, improvements and actionable tips"
          },
          "ai_detection": {
            "$ref": "#/components/schemas/AIDetectionResult",
            "description": "AI text authorship evaluation result"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAILED"
            ],
            "title": "Status",
            "description": "Overall pipeline execution status",
            "default": "SUCCESS"
          },
          "execution_time_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Execution Time Seconds",
            "description": "Total execution time in seconds"
          }
        },
        "type": "object",
        "required": [
          "submission_id",
          "word_count",
          "exemplar_model",
          "rubric_evaluation",
          "feedback",
          "ai_detection",
          "execution_time_seconds"
        ],
        "title": "EvaluationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthCheckResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operational status of the service"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service name"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Runtime environment"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Service version"
          },
          "zdr_enforced": {
            "type": "boolean",
            "title": "Zdr Enforced",
            "description": "Indicates if Zero Data Retention is active"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Verification timestamp UTC"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "environment",
          "version",
          "zdr_enforced",
          "timestamp"
        ],
        "title": "HealthCheckResponse"
      },
      "MistakeAnnotation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique mistake identifier"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Index",
            "description": "Character start offset in the original text"
          },
          "end_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End Index",
            "description": "Character end offset in the original text"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "description": "Original excerpt containing the mistake"
          },
          "correction": {
            "type": "string",
            "title": "Correction",
            "description": "Suggested correction"
          },
          "category": {
            "type": "string",
            "enum": [
              "grammar",
              "spelling",
              "punctuation",
              "vocabulary",
              "style"
            ],
            "title": "Category",
            "description": "Pedagogical category of the mistake"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Pedagogical explanation in Spanish explaining why it is an error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start_index",
          "end_index",
          "quote",
          "correction",
          "category",
          "explanation"
        ],
        "title": "MistakeAnnotation"
      },
      "PedagogicalFeedback": {
        "properties": {
          "overall_feedback": {
            "type": "string",
            "title": "Overall Feedback",
            "description": "Overall qualitative assessment summary in Spanish"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengths",
            "description": "Key strengths observed in the writing (2 to 4 points)"
          },
          "areas_for_improvement": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Areas For Improvement",
            "description": "Priority areas requiring correction and practice (2 to 4 points)"
          },
          "actionable_tips": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Actionable Tips",
            "description": "Actionable tips for future writing assignments (exactly 3 items)"
          }
        },
        "type": "object",
        "required": [
          "overall_feedback",
          "strengths",
          "areas_for_improvement",
          "actionable_tips"
        ],
        "title": "PedagogicalFeedback"
      },
      "RubricEvaluation": {
        "properties": {
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionEvaluation"
            },
            "type": "array",
            "title": "Criteria",
            "description": "Evaluation across the 4 Cambridge criteria"
          },
          "raw_score": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Raw Score",
            "description": "Total raw score sum across criteria (0 to 20)"
          },
          "max_raw_score": {
            "type": "number",
            "title": "Max Raw Score",
            "description": "Maximum raw score possible",
            "default": 20.0
          },
          "institutional_score": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Institutional Score",
            "description": "Calculated internal grade mapped to a 0.0 - 10.0 scale"
          },
          "length_penalty": {
            "type": "boolean",
            "title": "Length Penalty",
            "description": "Flag indicating if length penalty was applied",
            "default": false
          },
          "word_count_status": {
            "type": "string",
            "enum": [
              "NORMAL",
              "TOO_SHORT",
              "TOO_LONG"
            ],
            "title": "Word Count Status",
            "description": "Assessment of word length relative to required bounds",
            "default": "NORMAL"
          }
        },
        "type": "object",
        "required": [
          "criteria",
          "raw_score",
          "institutional_score"
        ],
        "title": "RubricEvaluation"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}