{
  "openapi": "3.1.0",
  "info": {
    "title": "Get Idiomas AI Evaluation Service",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root health endpoint",
        "operationId": "root_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Check operational health and Zero Data Retention policy status.",
        "operationId": "get_health_internal_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/evaluate": {
      "post": {
        "tags": [
          "Evaluation"
        ],
        "summary": "Evaluate writing submission",
        "description": "Executes the LangGraph evaluation pipeline over the candidate text.",
        "operationId": "evaluate_submission_internal_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/privacy/sanitize": {
      "post": {
        "tags": [
          "Privacy & Compliance",
          "Privacy & Compliance"
        ],
        "summary": "Sanitize Personally Identifiable Information (PII) from text",
        "description": "Mask student names, emails, phone numbers, DNI/NIE IDs, addresses, and institutions.",
        "operationId": "sanitize_text_internal_v1_privacy_sanitize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SanitizeTextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SanitizeTextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/privacy/status": {
      "get": {
        "tags": [
          "Privacy & Compliance",
          "Privacy & Compliance"
        ],
        "summary": "Get Zero Data Retention (ZDR) and GDPR compliance status",
        "description": "Return system Zero Data Retention compliance settings and active policies.",
        "operationId": "get_privacy_status_internal_v1_privacy_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZDRStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/privacy/validate-minor-consent": {
      "post": {
        "tags": [
          "Privacy & Compliance",
          "Privacy & Compliance"
        ],
        "summary": "Validate minor age and parental/guardian consent according to GDPR and LOPDGDD",
        "description": "Verify age threshold (< 14 in Spain) and legal guardian consent status.",
        "operationId": "validate_minor_consent_internal_v1_privacy_validate_minor_consent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MinorConsentValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinorConsentValidationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/privacy/right-to-erasure": {
      "post": {
        "tags": [
          "Privacy & Compliance",
          "Privacy & Compliance"
        ],
        "summary": "Execute Right to Erasure / Right to be Forgotten (GDPR Art. 17)",
        "description": "Pseudonymize submission text, purge photographic metadata, and issue an audit certificate.",
        "operationId": "execute_right_to_erasure_internal_v1_privacy_right_to_erasure_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErasureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErasureResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIDetectionResult": {
        "properties": {
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability",
            "description": "Estimated probability of synthetic AI generation"
          },
          "is_likely_ai": {
            "type": "boolean",
            "title": "Is Likely Ai",
            "description": "Alert flag indicating probable AI generation"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "title": "Confidence",
            "description": "Confidence band of the detection assessment"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale",
            "description": "Detailed justification of stylistic and syntactic indicators"
          }
        },
        "type": "object",
        "required": [
          "probability",
          "is_likely_ai",
          "confidence",
          "rationale"
        ],
        "title": "AIDetectionResult"
      },
      "CriterionEvaluation": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Assessment criterion (Content, Communicative Achievement, Organisation, Language)"
          },
          "score": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Assigned band score from 0.0 to 5.0"
          },
          "max_score": {
            "type": "number",
            "minimum": 1.0,
            "title": "Max Score",
            "description": "Maximum attainable band score",
            "default": 5.0
          },
          "band_descriptor": {
            "type": "string",
            "title": "Band Descriptor",
            "description": "Official descriptor matching the assigned band"
          },
          "justification": {
            "type": "string",
            "title": "Justification",
            "description": "Detailed pedagogical justification citing textual evidence"
          }
        },
        "type": "object",
        "required": [
          "name",
          "score",
          "band_descriptor",
          "justification"
        ],
        "title": "CriterionEvaluation"
      },
      "ErasureRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id",
            "description": "Student identifier"
          },
          "submission_text": {
            "type": "string",
            "title": "Submission Text",
            "description": "Student text submission to erase/pseudonymize"
          },
          "photo_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Photo Paths",
            "description": "Optional associated image paths to purge"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "student_id",
          "submission_text"
        ],
        "title": "ErasureRequest"
      },
      "ErasureResponse": {
        "properties": {
          "certificate_id": {
            "type": "string",
            "title": "Certificate Id",
            "description": "Unique certificate UUID"
          },
          "student_id_hash": {
            "type": "string",
            "title": "Student Id Hash",
            "description": "SHA-256 hash of the student identifier"
          },
          "erased_at": {
            "type": "string",
            "format": "date-time",
            "title": "Erased At",
            "description": "Timestamp of erasure execution in UTC"
          },
          "erased_items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Erased Items",
            "description": "List of components and paths erased"
          },
          "verification_hash": {
            "type": "string",
            "title": "Verification Hash",
            "description": "Cryptographic verification signature hash"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Status of the erasure operation",
            "default": "COMPLETED"
          }
        },
        "type": "object",
        "required": [
          "certificate_id",
          "student_id_hash",
          "erased_at",
          "erased_items",
          "verification_hash"
        ],
        "title": "ErasureResponse"
      },
      "EvaluationRequest": {
        "properties": {
          "submission_id": {
            "type": "string",
            "title": "Submission Id",
            "description": "UUID or unique identifier of the student submission"
          },
          "student_text": {
            "type": "string",
            "title": "Student Text",
            "description": "Student written submission text (can be empty if image_base64 is provided)",
            "default": ""
          },
          "image_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Base64",
            "description": "Optional Base64 encoded photograph of handwritten writing for multimodal OCR"
          },
          "task_prompt": {
            "type": "string",
            "minLength": 1,
            "title": "Task Prompt",
            "description": "Assignment writing prompt and instructions"
          },
          "level": {
            "type": "string",
            "enum": [
              "B1",
              "B2",
              "C1",
              "C2"
            ],
            "title": "Level",
            "description": "Target Cambridge / CEFR examination level"
          },
          "text_type": {
            "type": "string",
            "enum": [
              "essay",
              "article",
              "report",
              "review",
              "email",
              "proposal",
              "story"
            ],
            "title": "Text Type",
            "description": "Target text genre"
          },
          "min_words": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Words",
            "description": "Minimum expected word count"
          },
          "max_words": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Words",
            "description": "Maximum expected word count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "submission_id",
          "task_prompt",
          "level",
          "text_type"
        ],
        "title": "EvaluationRequest"
      },
      "EvaluationResponse": {
        "properties": {
          "submission_id": {
            "type": "string",
            "title": "Submission Id",
            "description": "Submission identifier"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Word Count",
            "description": "Total words counted in the student submission"
          },
          "mistakes": {
            "items": {
              "$ref": "#/components/schemas/MistakeAnnotation"
            },
            "type": "array",
            "title": "Mistakes",
            "description": "List of identified errors with character offsets"
          },
          "exemplar_model": {
            "type": "string",
            "title": "Exemplar Model",
            "description": "Band 5 exemplary rewritten version of the text"
          },
          "rubric_evaluation": {
            "$ref": "#/components/schemas/RubricEvaluation",
            "description": "Detailed Cambridge rubric bands evaluation and institutional grade"
          },
          "feedback": {
            "$ref": "#/components/schemas/PedagogicalFeedback",
            "description": "Pedagogical feedback including strengths, improvements and actionable tips"
          },
          "ai_detection": {
            "$ref": "#/components/schemas/AIDetectionResult",
            "description": "AI text authorship evaluation result"
          },
          "ocr_applied": {
            "type": "boolean",
            "title": "Ocr Applied",
            "description": "Whether multimodal OCR transcription was executed on an image",
            "default": false
          },
          "extracted_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extracted Text",
            "description": "Literal transcribed text if an image submission was provided"
          },
          "zdr_enforced": {
            "type": "boolean",
            "title": "Zdr Enforced",
            "description": "Whether Zero Data Retention (ZDR) was enforced for external LLM calls",
            "default": true
          },
          "sanitized_pii_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sanitized Pii Count",
            "description": "Total number of sensitive PII occurrences redacted before evaluation",
            "default": 0
          },
          "pii_types_detected": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pii Types Detected",
            "description": "Categories of PII detected and redacted (e.g. EMAIL, PHONE, ID, STUDENT_NAME)"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAILED"
            ],
            "title": "Status",
            "description": "Overall pipeline execution status",
            "default": "SUCCESS"
          },
          "execution_time_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Execution Time Seconds",
            "description": "Total execution time in seconds"
          }
        },
        "type": "object",
        "required": [
          "submission_id",
          "word_count",
          "exemplar_model",
          "rubric_evaluation",
          "feedback",
          "ai_detection",
          "execution_time_seconds"
        ],
        "title": "EvaluationResponse"
      },
      "GuardianConsentSchema": {
        "properties": {
          "guardian_name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 2,
            "title": "Guardian Name",
            "description": "Full name of legal guardian"
          },
          "guardian_email": {
            "type": "string",
            "maxLength": 255,
            "title": "Guardian Email",
            "description": "Email address of legal guardian"
          },
          "guardian_phone": {
            "type": "string",
            "maxLength": 50,
            "title": "Guardian Phone",
            "description": "Phone number of legal guardian"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "PARENT",
              "LEGAL_GUARDIAN"
            ],
            "title": "Relationship",
            "description": "Relationship to student (PARENT or LEGAL_GUARDIAN)"
          },
          "verification_method": {
            "type": "string",
            "enum": [
              "DIGITAL_SIGNATURE",
              "VERIFIED_EMAIL",
              "ACADEMY_PAPER"
            ],
            "title": "Verification Method",
            "description": "Verification method used for parental consent"
          },
          "consent_date": {
            "type": "string",
            "format": "date",
            "title": "Consent Date",
            "description": "Date when guardian consent was granted"
          },
          "document_hash": {
            "type": "string",
            "minLength": 16,
            "title": "Document Hash",
            "description": "Cryptographic hash of the consent document"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "REVOKED",
              "EXPIRED"
            ],
            "title": "Status",
            "description": "Current status of the consent record",
            "default": "ACTIVE"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "guardian_name",
          "guardian_email",
          "guardian_phone",
          "relationship",
          "verification_method",
          "consent_date",
          "document_hash"
        ],
        "title": "GuardianConsentSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthCheckResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Operational status of the service"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "description": "Service name"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Runtime environment"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Service version"
          },
          "zdr_enforced": {
            "type": "boolean",
            "title": "Zdr Enforced",
            "description": "Indicates if Zero Data Retention is active"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Verification timestamp UTC"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "environment",
          "version",
          "zdr_enforced",
          "timestamp"
        ],
        "title": "HealthCheckResponse"
      },
      "MinorConsentValidationRequest": {
        "properties": {
          "birth_date": {
            "type": "string",
            "format": "date",
            "title": "Birth Date",
            "description": "Student birth date"
          },
          "guardian_consent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GuardianConsentSchema"
              },
              {
                "type": "null"
              }
            ],
            "description": "Legal guardian consent details if student is under 14"
          },
          "reference_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Date",
            "description": "Optional reference date for age calculation (defaults to current date)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "birth_date"
        ],
        "title": "MinorConsentValidationRequest"
      },
      "MinorConsentValidationResponse": {
        "properties": {
          "is_minor": {
            "type": "boolean",
            "title": "Is Minor",
            "description": "True if age < 18"
          },
          "student_age": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Student Age",
            "description": "Calculated student age in completed years"
          },
          "requires_guardian_consent": {
            "type": "boolean",
            "title": "Requires Guardian Consent",
            "description": "True if age < 14 under Spanish LOPDGDD"
          },
          "is_valid": {
            "type": "boolean",
            "title": "Is Valid",
            "description": "True if consent criteria are satisfied to proceed"
          },
          "legal_basis": {
            "type": "string",
            "title": "Legal Basis",
            "description": "GDPR / LOPDGDD legal basis description"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors",
            "description": "Validation failure messages if any"
          }
        },
        "type": "object",
        "required": [
          "is_minor",
          "student_age",
          "requires_guardian_consent",
          "is_valid",
          "legal_basis"
        ],
        "title": "MinorConsentValidationResponse"
      },
      "MistakeAnnotation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique mistake identifier"
          },
          "start_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Index",
            "description": "Character start offset in the original text"
          },
          "end_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End Index",
            "description": "Character end offset in the original text"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "description": "Original excerpt containing the mistake"
          },
          "correction": {
            "type": "string",
            "title": "Correction",
            "description": "Suggested correction"
          },
          "category": {
            "type": "string",
            "enum": [
              "grammar",
              "spelling",
              "punctuation",
              "vocabulary",
              "style"
            ],
            "title": "Category",
            "description": "Pedagogical category of the mistake"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation",
            "description": "Pedagogical explanation in Spanish explaining why it is an error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start_index",
          "end_index",
          "quote",
          "correction",
          "category",
          "explanation"
        ],
        "title": "MistakeAnnotation"
      },
      "PedagogicalFeedback": {
        "properties": {
          "overall_feedback": {
            "type": "string",
            "title": "Overall Feedback",
            "description": "Overall qualitative assessment summary in Spanish"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengths",
            "description": "Key strengths observed in the writing (2 to 4 points)"
          },
          "areas_for_improvement": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Areas For Improvement",
            "description": "Priority areas requiring correction and practice (2 to 4 points)"
          },
          "actionable_tips": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Actionable Tips",
            "description": "Actionable tips for future writing assignments (exactly 3 items)"
          }
        },
        "type": "object",
        "required": [
          "overall_feedback",
          "strengths",
          "areas_for_improvement",
          "actionable_tips"
        ],
        "title": "PedagogicalFeedback"
      },
      "RedactionItem": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category",
            "description": "PII category (EMAIL, PHONE, ID, STUDENT_NAME, etc.)"
          },
          "replacement_token": {
            "type": "string",
            "title": "Replacement Token",
            "description": "Masked placeholder token"
          },
          "value_hash": {
            "type": "string",
            "title": "Value Hash",
            "description": "SHA-256 non-reversible hash for audit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "replacement_token",
          "value_hash"
        ],
        "title": "RedactionItem"
      },
      "RubricEvaluation": {
        "properties": {
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionEvaluation"
            },
            "type": "array",
            "title": "Criteria",
            "description": "Evaluation across the 4 Cambridge criteria"
          },
          "raw_score": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Raw Score",
            "description": "Total raw score sum across criteria (0 to 20)"
          },
          "max_raw_score": {
            "type": "number",
            "title": "Max Raw Score",
            "description": "Maximum raw score possible",
            "default": 20.0
          },
          "institutional_score": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Institutional Score",
            "description": "Calculated internal grade mapped to a 0.0 - 10.0 scale"
          },
          "length_penalty": {
            "type": "boolean",
            "title": "Length Penalty",
            "description": "Flag indicating if length penalty was applied",
            "default": false
          },
          "word_count_status": {
            "type": "string",
            "enum": [
              "NORMAL",
              "TOO_SHORT",
              "TOO_LONG"
            ],
            "title": "Word Count Status",
            "description": "Assessment of word length relative to required bounds",
            "default": "NORMAL"
          }
        },
        "type": "object",
        "required": [
          "criteria",
          "raw_score",
          "institutional_score"
        ],
        "title": "RubricEvaluation"
      },
      "SanitizeTextRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 50000,
            "minLength": 1,
            "title": "Text",
            "description": "Raw student text to sanitize"
          },
          "custom_entities": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Entities",
            "description": "Optional list of specific entity names to sanitize (e.g. known student full name)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SanitizeTextRequest"
      },
      "SanitizeTextResponse": {
        "properties": {
          "original_length": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Original Length",
            "description": "Character count of raw text"
          },
          "sanitized_text": {
            "type": "string",
            "title": "Sanitized Text",
            "description": "Sanitized text with masked PII placeholders"
          },
          "pii_detected_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Pii Detected Count",
            "description": "Total count of PII entities found and sanitized"
          },
          "pii_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pii Types",
            "description": "Unique categories of PII detected"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Word Count",
            "description": "Word count of the sanitized text"
          },
          "redactions": {
            "items": {
              "$ref": "#/components/schemas/RedactionItem"
            },
            "type": "array",
            "title": "Redactions",
            "description": "Audit log of sanitized items"
          }
        },
        "type": "object",
        "required": [
          "original_length",
          "sanitized_text",
          "pii_detected_count",
          "word_count"
        ],
        "title": "SanitizeTextResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
