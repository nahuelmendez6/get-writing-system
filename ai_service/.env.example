# AI Service Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Get Idiomas AI Evaluation Service"
VERSION="0.1.0"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8001

# Internal Security
INTERNAL_API_KEY=""

# LLM Provider Configuration
LLM_PROVIDER="mock"  # "mock" | "openai" | "anthropic" | "gemini"
LLM_MODEL_NAME="gpt-4o"
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45

# Zero Data Retention & Privacy
ENFORCE_ZDR=true
SANITIZE_PII=true

# AI Detection Configuration
AI_DETECTION_THRESHOLD=0.70
