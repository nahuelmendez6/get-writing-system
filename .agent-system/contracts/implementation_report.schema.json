{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationReport",
  "description": "Schema for implementation reports generated by the Implementer agent",
  "type": "object",
  "required": [
    "task_id",
    "implementer",
    "date",
    "status",
    "created_files",
    "modified_files",
    "test_files",
    "summary",
    "preflight_checks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+\\.[0-9]+$"
    },
    "implementer": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "PARTIALLY_COMPLETED", "BLOCKED"]
    },
    "created_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "modified_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "migrations_created": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "string"
    },
    "preflight_checks": {
      "type": "object",
      "required": ["formatted", "type_checked", "lint_passed", "tests_passed"],
      "properties": {
        "formatted": { "type": "boolean" },
        "type_checked": { "type": "boolean" },
        "lint_passed": { "type": "boolean" },
        "tests_passed": { "type": "boolean" }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
