{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskSpecification",
  "description": "Schema for technical specifications generated by the Planner agent",
  "type": "object",
  "required": [
    "task_id",
    "backlog_ref",
    "title",
    "target_module",
    "related_requirements",
    "summary",
    "acceptance_criteria",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+\\.[0-9]+$"
    },
    "backlog_ref": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "target_module": {
      "type": "string",
      "enum": ["backend", "ai_service", "frontend", "infrastructure", "fullstack"]
    },
    "related_requirements": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["PLANNED", "WAITING_HUMAN_APPROVAL"]
    },
    "database_changes": {
      "type": "object",
      "properties": {
        "migration_required": { "type": "boolean" },
        "tables_affected": { "type": "array", "items": { "type": "string" } },
        "breaking_changes": { "type": "boolean" }
      }
    },
    "api_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "status_code"],
        "properties": {
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "path": { "type": "string" },
          "status_code": { "type": "integer" },
          "request_schema": { "type": "string" },
          "response_schema": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "given", "when", "then"],
        "properties": {
          "scenario": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "security_considerations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
