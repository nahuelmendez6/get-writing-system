{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestReport",
  "description": "Schema for test verification reports generated by the Tester agent",
  "type": "object",
  "required": [
    "task_id",
    "tester",
    "date",
    "iteration",
    "verdict",
    "summary",
    "security_checks_passed"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+\\.[0-9]+$"
    },
    "tester": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "verdict": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED"]
    },
    "summary": {
      "type": "object",
      "required": ["total_tests", "passed", "failed", "skipped", "duration_seconds"],
      "properties": {
        "total_tests": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "coverage_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "duration_seconds": { "type": "number" }
      }
    },
    "security_checks_passed": {
      "type": "boolean"
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defect_id", "title", "failing_test", "observed_behavior", "required_remediation"],
        "properties": {
          "defect_id": { "type": "string" },
          "title": { "type": "string" },
          "failing_test": { "type": "string" },
          "observed_behavior": { "type": "string" },
          "root_cause": { "type": "string" },
          "required_remediation": { "type": "string" }
        }
      }
    },
    "recommendation": {
      "type": "string"
    }
  }
}
