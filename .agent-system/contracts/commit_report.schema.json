{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommitReport",
  "description": "Schema for commit execution reports generated by the Committer agent",
  "type": "object",
  "required": [
    "task_id",
    "committer",
    "date",
    "commit_hash",
    "commit_type",
    "scope",
    "message",
    "files_committed",
    "verification_passed"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+\\.[0-9]+$"
    },
    "committer": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "commit_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,40}$"
    },
    "commit_type": {
      "type": "string",
      "enum": ["feat", "fix", "docs", "style", "refactor", "perf", "test", "chore"]
    },
    "scope": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "files_committed": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification_passed": {
      "type": "boolean"
    }
  }
}
