{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentationReport",
  "description": "Schema for documentation reports generated by the Documenter agent",
  "type": "object",
  "required": [
    "task_id",
    "documenter",
    "date",
    "status",
    "updated_docs",
    "openapi_synchronized",
    "changelog_updated",
    "summary"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]+\\.[0-9]+$"
    },
    "documenter": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "SKIPPED"]
    },
    "updated_docs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "openapi_synchronized": {
      "type": "boolean"
    },
    "changelog_updated": {
      "type": "boolean"
    },
    "adr_created": {
      "type": "boolean"
    },
    "adr_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  }
}
