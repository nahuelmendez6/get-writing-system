# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Testing, type checking and linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.eslintcache/

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
logs/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor folders
.vscode/
.idea/
*.swp
*.swo

# Temporary scratch and execution artifacts
tasks/*/scratch/
state/scratch/
