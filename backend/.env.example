# Environment & Application
ENVIRONMENT=development
PROJECT_NAME="Get Idiomas AI Writing System"
VERSION="0.1.0"
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=get_idiomas
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/get_idiomas
DB_ECHO=false

# CORS & Security
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Redis Cache & Broker (Future Phase integration)
REDIS_URL=redis://localhost:6379/0
