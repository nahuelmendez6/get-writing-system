      "post": {
        "tags": [
          "Rubrics"
        ],
        "summary": "Add criterion to rubric",
        "description": "Attach an individual assessment criterion to an existing rubric.",
        "operationId": "add_criterion_to_rubric_api_v1_rubrics__id__criteria_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Id"
