              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rubrics/{id}": {
      "get": {
        "tags": [
          "Rubrics"
        ],
        "summary": "Get rubric by ID",
        "description": "Retrieve rubric details including criteria and band descriptors.",
        "operationId": "get_rubric_api_v1_rubrics__id__get",
